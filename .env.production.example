# RDS MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://jubjub-prod-db.ch44uyu8acxi.ap-southeast-2.rds.amazonaws.com:3306/jubjub?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Spring Security
JWT_SECRET=
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# Backend CORS (comma-separated HTTPS origins)
CORS_ALLOWED_ORIGINS=https://<frontend-domain>

# Mail
MAIL_USERNAME=
MAIL_PASSWORD=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CoolSMS
COOLSMS_API_KEY=
COOLSMS_API_SECRET=
COOLSMS_SENDER=

# TMAP
TMAP_APP_KEY=
TMAP_PEDESTRIAN_URL=https://apis.openapi.sk.com/tmap/routes/pedestrian
TMAP_GEOCODING_URL=https://apis.openapi.sk.com/tmap/geo/fullAddrGeo

# PortOne
PORTONE_API_SECRET=
PORTONE_BASE_URL=https://api.portone.io
PORTONE_WEBHOOK_SECRET=

# AWS S3 (credentials are supplied by the EC2 instance role)
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=jubjub-images-prod-294427323709-ap-southeast-2-an
AWS_S3_PUBLIC_BASE_URL=https://d3g5nlpx9221c8.cloudfront.net
AWS_S3_PRESIGN_DURATION=10m
AWS_S3_MAX_FILE_SIZE_BYTES=10485760
